# 运行时产物 / 缓存 / 二进制 / 本机私有数据 —— 一律不入库
__pycache__/
*.pyc
*.pyo
.codegraph/codegraph.db
.codegraph/*.db
_backup-v2-*/
_backup-*/
_备份-*/
*.bak-*
*.db.bak-*

# 唯一真源：真实运行库含本机内部项目状态、通知与对话历史，属私人运行数据。
# 结构以 data/schema.sql 公开；服务启动会自动重建。
data/state.db
data/state.db-journal
data/state.db-wal
data/state.db-shm

# 本轮运行态产物 / 一次性补丁 / 诊断临时文件（保留在本机，不入库）
data/_v4_*.py
data/结构化证据-*.md
data/结构化证据提取报告-*.md
data/自动复核-*.md
_启动诊断-*.txt
data/_v5_*.py
data/_v5_*.json

# P0 桥接运行时缓存：插件 outbox（未送达事件）与插件日志，属运行态，不入库
data/bridge-cache/

# v3 中间轮验收截图（每轮多次运行产生的中间产物，非最终交付；最终交付用 v4/v5-*.png）
验收/v3-*.png

# 本地日志与临时文件
logs/
*.log
~$*
Thumbs.db
desktop.ini